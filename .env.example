# ProofDrop runs safely in simulated demo mode by default.
DEMO_MODE=true
API_HOST=127.0.0.1
API_PORT=4000
# Server-only backend URL used by the Next.js mutation proxy.
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Server-only secret required for real-mode verify-payment, proof, and anchor mutations.
# The Next.js server reads it and adds the header only to the allowlisted API proxy.
# Never put this value in NEXT_PUBLIC_* variables or browser code.
API_MUTATION_SECRET=

# Stellar Testnet. Public defaults are included; real mode requires a recipient and mutation secret.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_USDC_CODE=USDC
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_RECIPIENT_PUBLIC_KEY=

# Avalanche Fuji C-Chain. The adapter also verifies chain ID 43113 before accepting evidence.
AVALANCHE_NETWORK=fuji
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_PRIVATE_KEY=
AVALANCHE_REGISTRY_ADDRESS=

# Pollar is intentionally disabled. No hackathon-specific endpoint is assumed.
POLLAR_ADAPTER_ENABLED=false

# Optional production persistence settings for a future PostgreSQL repository adapter.
DATABASE_URL=
DATABASE_SSL=false

# Public API URL for server-rendered reads. It is not used by the mutation proxy.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
